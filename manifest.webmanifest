{
  "id": "https://azzabazza11.github.io/golf-tracker/",
  "name": "Golf Shot Tracker",
  "short_name": "Shot Tracker",
  "start_url": "./?homescreen=1",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone", "minimal-ui"],
  "background_color": "#000000",
  "theme_color": "#000000",
  "description": "Simple on-course golf shot tracking with local-only storage.",
  "icons": [
    {
      "src": "./app-icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./app-icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./app-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
